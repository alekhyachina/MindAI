# Copy this file to .env and fill in your real values. Never commit .env itself.

# --- Required ---
OPENAI_API_KEY=sk-...
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MINDAI_JWT_SECRET=

# --- Optional: models (defaults shown) ---
MINDAI_GENERATION_MODEL=gpt-4o-mini
MINDAI_REWRITE_MODEL=gpt-4o-mini
MINDAI_JUDGE_MODEL=gpt-4o

# --- Optional: storage (defaults shown) ---
DATABASE_URL=sqlite:///./mindai.db
MINDAI_QDRANT_PATH=./qdrant_storage
MINDAI_CALL_GRAPH_DIR=./call_graphs

# --- Optional: chunking. "ast" or "semantic". Changing it requires re-ingesting ---
MINDAI_CHUNK_STRATEGY=ast

# --- Optional: hosted Qdrant. Set QDRANT_URL to use a server instead of local on-disk ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Optional: set to use Cohere hosted reranking instead of local CrossEncoder ---
MINDAI_COHERE_API_KEY=

# --- Optional: OpenAI-compatible alternative LLM provider (e.g. Gemini) ---
# MINDAI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MINDAI_LLM_API_KEY=
