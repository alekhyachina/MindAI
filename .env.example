# Copy this file to .env and fill in your real key. Never commit .env itself.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
MINDAI_GENERATION_MODEL=gpt-4o-mini
MINDAI_REWRITE_MODEL=gpt-4o-mini
MINDAI_JUDGE_MODEL=gpt-4o

# --- To use Gemini instead of OpenAI for generation/query-rewrite ---
# (via Gemini's OpenAI-compatibility endpoint — same openai SDK, different
# base URL and key. Leave both blank to use OpenAI normally.)
# MINDAI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MINDAI_LLM_API_KEY=your-gemini-api-key
# MINDAI_GENERATION_MODEL=gemini-3.5-flash
# MINDAI_REWRITE_MODEL=gemini-3.5-flash

# --- To use Cohere's hosted Rerank API instead of the local CrossEncoder ---
# (reranking is the one remaining CPU-bound pipeline step; setting this
# swaps it for a network call — see reranker.py. Leave blank to keep
# reranking local.)
# MINDAI_COHERE_API_KEY=your-cohere-api-key

# --- Backend (FastAPI) ---
# Signs JWT session tokens. REQUIRED in any real deployment — if unset, the
# backend generates a random secret at every process start, which silently
# invalidates every issued token on restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MINDAI_JWT_SECRET=

# SQLite by default (zero-config). Point at Postgres for production, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/mindai
DATABASE_URL=sqlite:///./mindai.db

# Where the shared on-disk Qdrant collection and cached call graphs live.
MINDAI_QDRANT_PATH=./qdrant_storage
MINDAI_CALL_GRAPH_DIR=./call_graphs
